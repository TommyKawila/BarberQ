# Copy to .env.local for local dev. Never commit real secrets.
# Full QA setup (Thai): docs/qa-setup.md
#
# Production runtime requires:
#   NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
#   NEXT_PUBLIC_LIFF_ID, NEXT_PUBLIC_APP_URL, SUPERADMIN_TOKEN
# QA deploy also requires BARBERQ_ENV=founder_qa and a dedicated Supabase + LIFF
# (do not reuse Production keys). See docs/qa-setup.md.

# Public (inlined into client bundle) — Vercel: Config (non-secret)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_LIFF_ID=
NEXT_PUBLIC_APP_URL=
# Optional: ClipperQ Demo shop slug for /demo and OA rich menu (default: clipperqdemo)
# Prod seed: supabase/scripts/seed_clipperq_demo_prod.sql
NEXT_PUBLIC_DEMO_SHOP_SLUG=
# Optional: hides Add Friend CTA when absent
NEXT_PUBLIC_LINE_OA_ADD_URL=
# Optional: hides setup help chat CTA when absent (falls back to ClipperQ OA lin.ee)
NEXT_PUBLIC_BARBERQ_SUPPORT_LINE_URL=
# Optional: Microsoft Clarity project id (sale/trial pages only; no-op if unset)
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# P4 Web Push (Vercel: Config — must be public for PushManager.subscribe)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server only — Vercel: Secret
SUPABASE_SERVICE_ROLE_KEY=
SUPERADMIN_TOKEN=
# P4: encrypt per-shop LINE Channel Secret / Access Token at rest (32-byte hex or any passphrase)
APP_ENCRYPTION_KEY=
# P4 Web Push VAPID private key + contact subject
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:setup@barberqx.com
# P5: Vercel Cron auth for /api/cron/reminders (Authorization: Bearer …)
# Hobby: vercel.json cron is daily (0 1 * * *). On Pro, switch to */5 * * * *.
CRON_SECRET=
# Optional invite email domain for setup+{shopId}@…
BARBERQX_SETUP_EMAIL_DOMAIN=barberqx.com

# Deprecated for P4 (per-shop credentials replace this). Kept for local/legacy no-op.
LINE_CHANNEL_ACCESS_TOKEN=

# Infra identity only. Never grants auth/role. Destructive QA tooling requires founder_qa.
# Values: local | founder_qa | production
# Local prototype (memory store): leave unset or "local" and omit Supabase keys.
# QA Vercel project: founder_qa
# Production Vercel project: production
BARBERQ_ENV=

# QA UI crawl / Playwright admin session (barberq-qa ONLY — never set on Production).
# Enables POST /api/qa/e2e-session when BARBERQ_ENV=founder_qa AND Supabase is barberq-qa.
# Tommy: add name only on Vercel project barberq-qa (Secret). Do not commit the value.
QA_E2E_SECRET=

# Declared but unused by current code (no admin-secret path)
ADMIN_SECRET_KEY=
# Per-shop secrets live in DB; global LINE_CHANNEL_SECRET unused for webhooks
LINE_CHANNEL_SECRET=

# Set automatically by Vercel — do not set manually
# VERCEL_URL=
