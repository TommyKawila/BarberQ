# Public (inlined into client bundle)
# Required in production: NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_LIFF_ID, NEXT_PUBLIC_APP_URL
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_LIFF_ID=
NEXT_PUBLIC_APP_URL=
# Optional: hides Add Friend CTA when absent
NEXT_PUBLIC_LINE_OA_ADD_URL=
# Optional: hides setup help chat CTA when absent
NEXT_PUBLIC_BARBERQ_SUPPORT_LINE_URL=

# Server only
# Required in production: SUPABASE_SERVICE_ROLE_KEY, SUPERADMIN_TOKEN
SUPABASE_SERVICE_ROLE_KEY=
# Optional: booking works without push; logs skip when absent
LINE_CHANNEL_ACCESS_TOKEN=
SUPERADMIN_TOKEN=

# Declared but unused by current code
ADMIN_SECRET_KEY=
LINE_CHANNEL_SECRET=
